# Copy to .env.local and fill in. Never commit real values.
# Email and password used to sign in at /admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 32+ random characters used to sign the session cookie, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Name shown as "Processed by" on admin actions (optional)
ADMIN_NAME=
